# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_DW_DB=pulsecheck_dw
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Apache Airflow Configuration
# -----------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@driftline.local
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
# Generate a Fernet key for production/non-trivial local use:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=replace-with-random-local-secret

# -----------------------------------------------------------------------------
# AWS / S3 Configuration (Placeholders for Future Pipeline Milestones)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1
DRIFTLINE_S3_BUCKET=your-driftline-s3-bucket

